# Managed by keycloak-install.yaml (Keycloak {{ keycloak_version }}), later changes by keycloak-tls-deploy.yaml and keycloak-upgrade.yaml
# Hostname v2: full URL, also used as the issuer of every realm (https://{{ inventory_hostname }}:{{ keycloak_https_port }}/realms/<realm>)
hostname=https://{{ inventory_hostname }}:{{ keycloak_https_port }}
http-enabled=false
https-port={{ keycloak_https_port }}
https-certificate-file={{ keycloak_tls_dir }}/{{ keycloak_cert_name }}.crt
https-certificate-key-file={{ keycloak_tls_dir }}/{{ keycloak_cert_name }}.key
db=dev-file
