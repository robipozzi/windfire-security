# Application name
APP_NAME=Windfire Security Authentication Service

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PORT_SECURE=8443

# SSL Configuration (comment out for HTTP)
SSL_KEYFILE=./ssl/<PUT_KEY_FILE_NAME_HERE>.key
SSL_CERTFILE=./ssl/<PUT_CERT_FILE_NAME_HERE>.crt

# HTTPS Configuration
ENFORCE_HTTPS=true  # Set to True/true to enable HTTPS enforcement, Set to False/false to disable HTTPS enforcement (dev only)
ALLOWED_HOSTS=localhost,yourdomain.com,api.yourdomain.com

# Keycloak Configuration
KEYCLOAK_SERVER_URL=<PUT_KEYCLOAK_SERVER_URL_HERE>

# Whether to verify Keycloak's TLS certificate on outgoing server->Keycloak calls
# (defaults to true if unset). Set to False/false only for local dev without TLS.
KEYCLOAK_VERIFY_SSL_CERTS=true
# Path to the Windfire Keycloak Root CA certificate, created by keycloak/security/setupTLS.sh
# (e.g. $HOME/opt/keycloak/ssl/truststore/WindfireKeycloakRootCA.crt) -
# this is NOT the Windfire Root CA. Keycloak's TLS is signed by its own separate CA.
KEYCLOAK_CA_CERT_PATH=<PUT_KEYCLOAK_CA_CERT_PATH_HERE>