# Managed by Ansible (templates/windfire-security.env.j2) - local changes are overwritten on deploy
# Non-secret configuration only: the per-service Keycloak client secrets (service_config.json) are loaded
# by systemd from /etc/credstore.encrypted and read through SERVICE_CONFIG_FILE

# Application name
APP_NAME={{ app_name }}

# Server Configuration
API_HOST=0.0.0.0
API_PORT={{ api_port }}
API_PORT_SECURE={{ api_port_secure }}

# SSL Configuration
SSL_KEYFILE=./ssl/{{ windfire_server_key }}
SSL_CERTFILE=./ssl/{{ windfire_server_certificate }}

# HTTPS Configuration
ENFORCE_HTTPS=true
ALLOWED_HOSTS={{ allowed_hosts }}

# Keycloak Configuration
KEYCLOAK_SERVER_URL={{ keycloak_server_url }}
KEYCLOAK_VERIFY_SSL_CERTS=true
# Windfire Keycloak Root CA (not the Windfire Root CA): Keycloak's TLS is signed by its own separate CA
KEYCLOAK_CA_CERT_PATH={{ remote_keycloak_truststore_dir }}/{{ keycloak_ca_root_certificate }}
